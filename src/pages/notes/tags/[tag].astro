---
import Base from "@layouts/Base.astro";
import { getPublicNotes } from "@src/lib/notes";

export async function getStaticPaths() {
  const notes = await getPublicNotes();

  const tags = [
    ...new Set(
      notes
        .map((note) => note.data.tags)
        .filter(Boolean) // Remove null/undefined values
        .flat(),
    ),
  ];

  return tags.map((tag) => {
    const filteredNotes = notes.filter(
      (note) => note.data.tags && note.data.tags.includes(tag),
    );
    return {
      params: { tag },
      props: { notes: filteredNotes },
    };
  });
}

const { tag } = Astro.params;
const { notes } = Astro.props;
---

<Base title=`Notes tagged '${tag}'`>
  <h1>Notes tagged ‘{tag}’</h1>
  <div id="body">
    <ul class="notes">
      {
        notes.map((note) => (
          <li class="note">
            <a href={`/notes/${note.id}/`}>{note.data.title}</a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style lang="scss">
  ul.notes {
    display: grid;
    gap: 0.5em;
  }
</style>
