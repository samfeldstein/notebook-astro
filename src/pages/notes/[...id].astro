---
import Base from "@layouts/Base.astro";
import Header from "@components/notes/Header.astro";
import Toc from "@src/components/notes/Toc.astro";

import "@styles/layouts/_note.scss";

import { components } from "@components/global";

import { getCollection, render } from "astro:content";
// 1. Generate a new path for every collection entry

// Generate a route for every note.
// Private notes are included on the dev server, but omitted from production builds.
export async function getStaticPaths() {
  const notes = await getCollection(
    "notes",
    ({ data }) => import.meta.env.DEV || data.private !== true,
  );

  return notes.map((note) => ({
    params: { id: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content, headings } = await render(note);
---

<Base title={note.data.title} description={note.data.description}>
  <article data-pagefind-body>
    <Header note={note} />

    {
      headings.length > 0 ? (
        <div id="note-body-wrapper">
          <Toc headings={headings} />
          <div id="body">
            <Content components={components} />
          </div>
        </div>
      ) : (
        <div id="body">
          <Content components={components} />
        </div>
      )
    }
  </article>
</Base>

<style>
  #note-body-wrapper {
    max-width: 80rem;
    margin: 0 auto;

    @media screen and (min-width: 1024px) {
      display: grid;
      grid-template-columns: 1fr 4fr;
      gap: 2em;
    }
  }

  @media screen and (min-width: 1024px) {
    #note-body-wrapper {
      position: relative;
    }
    
    /* Remove top margin on first element in the body to align with toc. Global because the :first-child is not in the html here */
    :global(#body > :first-child) {
      margin-top: 0;
    }
  }
</style>
