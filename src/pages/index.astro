---
import Base from "@layouts/Base.astro";
import { site } from "@data/config";
import Callout from "@components/notes/Callout.astro";

import "@styles/pages/_home.scss";
---

<Base title="Home" description={site.description}>
	<h1>Sam Feldstein’s Notebook</h1>

	<div id="body">
		<Callout>
			<p>
				This notebook is mostly retired. It became a hassle to separate private
				and public notes, and I figured not too many people were looking at it
				anyway. It stays up so old links keep working, but I rarely add to it
				now.
			</p>
		</Callout>

		<p>
			Welcome to my digital notebook, also known as a <a
				href="https://www.buildingasecondbrain.com">second brain</a
			> or a <a href="https://maggieappleton.com/garden-history"
				>digital garden</a
			>. I call it a notebook, because a notebook is something you write in and
			that’s what I’m doing here.
		</p>
	</div>
</Base>

<style>
	#body {
		max-width: 60rem;
		margin: 0 auto;
	}
</style>
