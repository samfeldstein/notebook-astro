<search class="dev-note-search">
  <label>
    <input
      type="search"
      placeholder="Search notes…"
      autocomplete="off"
      autofocus
      data-dev-search-input
    />
  </label>

  <!-- Shows loading, error, and no-results messages. -->
  <p data-dev-search-status aria-live="polite">Loading notes…</p>

  <!-- JavaScript inserts matching note links here. -->
  <ul data-dev-search-results aria-live="polite"></ul>
</search>

<style>
  search {
    display: grid;
    width: min(100%, 40rem);
    margin-inline: auto;
  }

  p[data-dev-search-status] {
    font-style: italic;
  }

  input {
    box-sizing: border-box;
    width: 100%;
    max-width: none;

    font: inherit;
    border: 1px solid;
    border-radius: 4px;
    padding: 0.5em;

    &:focus {
      outline: 1px solid currentColor;
    }
  }

  ul[data-dev-search-results] {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1em;

    li {
      border: none;
    }
  }
</style>

<script>
  // The DEV check is replaced at build time, so production drops the
  // import and Fuse.js never ends up in dist.
  if (import.meta.env.DEV) {
    import("../scripts/dev-search");
  }
</script>
