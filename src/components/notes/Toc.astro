---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
---

<!-- filepath: /Users/Samfeld/projects/dev/sites/notebook/src/components/TableOfContents.astro -->{
  headings.length > 0 && (
    <details open>
      <summary>Contents</summary>
      <nav class="table-of-contents" aria-labelledby="toc-heading">
        <ol>
          {headings.map((heading) => (
            <li class={`depth-${heading.depth}`}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    </details>
  )
}

<style lang="scss">
  details {
    border: 0.01em solid currentColor;
    background-color: var(--background-contrast);
    padding: 0.5em;

    height: fit-content;
  }

  summary {
    font-weight: 600;
  }

  nav {
    padding: 1em;

    height: fit-content;
  }

  nav a {
    font-size: 0.8em;
    font-variant: unset;
    text-transform: unset;
  }

  ol {
    display: grid;
    gap: 0.5em;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .depth-3 {
    padding-inline-start: 1em;
  }

  .depth-4 {
    padding-inline-start: 2em;
  }

  .depth-5 {
    padding-inline-start: 3em;
  }

  .depth-6 {
    padding-inline-start: 4em;
  }
</style>
