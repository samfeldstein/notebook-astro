# Hashed build output
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts are versioned by filename (e.g. noto-serif.v2.woff2); rename on change.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Pagefind index and fragments are content-hashed
/pagefind/fragment/*
  Cache-Control: public, max-age=31536000, immutable

/pagefind/index/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed icons: cache for a week
/favicon*
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/android-chrome-*
  Cache-Control: public, max-age=604800

# Always revalidate the service worker
/sw.js
  Cache-Control: no-cache
